APP_NAME=Goal Engine

# MySQL (create the database and user first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goal_engine
DB_USER=goal_engine
DB_PASSWORD=

# AI providers, tried in this order. Empty key = skipped.
AI_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Safety limits for the public demo
AI_DAILY_CAP=400
VISITOR_DAILY_CAP=25
MAX_MESSAGE_CHARS=1500

# true when served over HTTPS
COOKIE_SECURE=true
