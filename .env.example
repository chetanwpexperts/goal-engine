APP_NAME=Goal Engine

# MySQL (create the database and user first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goal_engine
DB_USER=goal_engine
DB_PASSWORD=

# ml = own machine-learning engine (no external AI, default); ai = Gemini/Groq
ENGINE_MODE=ml

# AI providers (AI mode), tried in this order. Empty key = skipped.
AI_PROVIDER_ORDER=gemini,groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING=low
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Safety limits for the public demo
AI_DAILY_CAP=400
VISITOR_DAILY_CAP=25
MAX_MESSAGE_CHARS=1500

# true when served over HTTPS
COOKIE_SECURE=true

# Email sending for agents (reminders, reports, verification codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Long random string for signing verification codes
APP_SECRET=
# on = AI planner for automations the rule planner doesn't know (uses the AI providers above)
PLANNER_AI=off

# Public address used in the connector install command (optional; worked out from the request otherwise)
PUBLIC_URL=https://solve.chetanbuilds.com

# Shown on the connect form so users can allow it under "Remote MySQL" (this server's public IP)
SERVER_IP=

# Coming soon: the site is closed unless SITE_MODE=open. Private entry: /preview?key=<PREVIEW_KEY> (16+ chars)
SITE_MODE=closed
PREVIEW_KEY=

# Expert requests: where the alert email goes (defaults to SMTP_USER), and the private key for /admin?key=...
EXPERT_EMAIL=
ADMIN_KEY=
