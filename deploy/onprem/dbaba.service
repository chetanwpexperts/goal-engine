[Unit]
Description=DBaba local database assistant
After=network.target

[Service]
Type=simple
@SERVICE_USER@
WorkingDirectory=@DIR@
ExecStart=@COMMAND@
Environment="SITE_MODE=open"
Environment="ENGINE_MODE=ml"
Environment="AGENT_SCHEDULER=on"
Environment="DBABA_LOCAL=1"
Environment="DATABASE_URL=sqlite:///@DIR@/data/dbaba.db"
Environment="COOKIE_SECURE=false"
Environment="EXPOSE_INTERNALS=0"
Environment="GEMINI_API_KEY="
Environment="GROQ_API_KEY="
Environment="AI_PROVIDER_ORDER="
Environment="PYTHONUNBUFFERED=1"
UMask=0077
NoNewPrivileges=yes
@SYSTEM_HARDENING@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=@TARGET@
